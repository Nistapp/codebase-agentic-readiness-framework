# python
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/

# build output (root-scoped so fixture directories that deliberately use these names are still committed)
/dev/dist/
/audit/engine/dist/
# `make self-audit` output
/dist/
*.pyz

# probe-run caches in fixtures (the engine's opt-in probe runner can leave them behind)
**/.gradle/
**/.pytest_cache/

# environment files (secrets never committed; templates are), at any depth
# The engine's fixtures hold `.env` files as data (audit/engine/tests/fixtures/*/.env). They are already tracked, and
# git keeps tracking them. A new fixture `.env` is added with `git add -f` and a note in its test, like the key
# material below.
.env
.env.*
!.env.example

# secret and key material by shape. A fixture that needs one of these is added with `git add -f` and a note in its
# test; nothing in the repository's own configuration should ever be one.
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
*.crt
*.cer
.aws/

# editor / OS noise
.DS_Store
Thumbs.db
*.swp
