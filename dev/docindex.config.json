{
  "default_zone": "docs",
  "description": "The project config of the document index (dev/doc_index.py). zones: the longest matching path prefix wins, else default_zone. ids: a regex per ID kind whose group 1 is the ID, and the paths that define such IDs. exclude.skip: never read or listed. exclude.list_only: listed as file nodes but not parsed. sweep: the bundle sources named by the constants of bundle_references.module, plus paths and every file named in file_names outside the exclusions.",
  "exclude": {
    "list_only": [
      "audit/engine/tests/fixtures/",
      "dev/eval/expected/fixtures/",
      "dev/eval/implement-fixtures/"
    ],
    "skip": [
      "artefacts/"
    ]
  },
  "file_kinds": {
    ".json": "json",
    ".md": "markdown",
    ".py": "python",
    ".yaml": "yaml",
    ".yml": "yaml"
  },
  "ids": {
    "adr": {
      "defined_in": [
        "audit/docs/architecture/adrs/",
        "audit/engine/docs/architecture/adrs/",
        "docs/architecture/adrs/",
        "implement/docs/architecture/adrs/",
        "spec/decisions/"
      ],
      "pattern": "\\bADR[- ]?(\\d{1,4})\\b"
    },
    "check": {
      "defined_in": [
        "audit/catalogue.json"
      ],
      "pattern": "\\b([A-Z]{2,4}-\\d{2})\\b"
    },
    "playbook": {
      "defined_in": [
        "implement/playbooks/"
      ],
      "pattern": "\\bimplement/playbooks/([a-z0-9-]+)\\.md\\b"
    },
    "requirement": {
      "defined_in": [
        "spec/"
      ],
      "pattern": "\\b(REQ-[A-Z]+-\\d{3})\\b"
    },
    "schema": {
      "defined_in": [
        "audit/schema/"
      ],
      "pattern": "\\b([a-z0-9-]+\\.schema\\.json)\\b"
    },
    "tool": {
      "defined_in": [
        "audit/tools/",
        "implement/tools/"
      ],
      "pattern": "\\b((?:audit|implement)/tools/[a-z_]+\\.py)\\b"
    }
  },
  "sweep": {
    "bundle_references": {
      "constants": [
        "AUDIT_REFERENCES",
        "IMPLEMENT_REFERENCES"
      ],
      "module": "dev/build_skills.py"
    },
    "file_names": [
      "AGENTS.md"
    ],
    "paths": [
      "greenfield/templates/"
    ]
  },
  "zones": {
    ".github/": "dev",
    "Makefile": "dev",
    "audit/": "recipe",
    "audit/docs/": "docs",
    "audit/engine/": "engine",
    "audit/engine/docs/": "docs",
    "audit/engine/tests/fixtures/": "fixture",
    "audit/tools/": "tools",
    "dev/": "dev",
    "dev/eval/expected/fixtures/": "fixture",
    "dev/eval/implement-fixtures/": "fixture",
    "docs/": "docs",
    "greenfield/": "docs",
    "greenfield/bootstrap/": "tools",
    "implement/": "recipe",
    "implement/docs/": "docs",
    "implement/tools/": "tools",
    "lefthook.yml": "dev",
    "spec/": "spec"
  }
}
