  {
    "binding": "file",
    "check": "AGT-02",
    "note": "The root manifests declare the components (components.py); for each one <component>/AGENTS.md must exist, matched as a path suffix at any depth. The root component is left out, so the root AGENTS.md never counts. The suffix test runs over agt.instruction_paths, which scans every instruction file name, but only a path ending in <component>/AGENTS.md counts, so the other names are never read for this check.",
    "source": "engine",
    "threshold": "every declared component has an AGENTS.md",
    "what": {
      "kind": "exists"
    },
    "where": [
      {
        "path": "*/**/AGENTS.md",
        "scope": "glob"
      },
      {
        "path": "package.json",
        "scope": "root",
        "via": "components"
      },
