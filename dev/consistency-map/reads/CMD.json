[
  {
    "binding": "file",
    "check": "CMD-01",
    "constants": [
      "audit.rules.checks._common:RUNNER_PRECEDENCE"
    ],
    "note": "Every runner (package.json, the Makefile, the Taskfile, pyproject.toml, the Gradle and the Maven build) counts only at the root, where it is read. A root gradlew or mvnw only chooses the launcher. format:check is also read under the spelling its runner accepts.",
    "source": "engine",
    "threshold": "all seven verbs on one runner",
    "what": {
      "kind": "key",
      "text": [
        "format",
        "format:check",
        "lint",
        "typecheck",
        "test",
        "check",
        "security"
      ]
    },
    "where": [
      {
        "path": "package.json",
        "scope": "root"
      },
      {
        "path": "Makefile",
        "scope": "root"
      },
      {
        "path": "Taskfile.yml",
        "scope": "root"
      },
      {
        "path": "Taskfile.yaml",
        "scope": "root"
      },
      {
        "path": "pyproject.toml",
        "scope": "root"
      },
