[
  {
    "binding": "file",
    "check": "CI-01",
    "note": "GitHub needs the key at a line start or pull_request in an on: [...] list, Azure pr: at a line start; GitLab and Jenkins match anywhere, CircleCI and Buildkite never count. Inventory.match also compares the base name, so .gitlab-ci.yml, Jenkinsfile and azure-pipelines.yml are found at any depth.",
    "source": "engine",
    "threshold": "a workflow with a pull-request trigger",
    "what": {
      "kind": "key",
      "text": [
        "pull_request",
        "pull_request_target",
        "merge_request",
        "pr",
        "changeRequest"
      ]
    },
    "where": [
      {
        "path": ".github/workflows/*.yml",
        "scope": "glob"
      },
      {
        "path": ".github/workflows/*.yaml",
        "scope": "glob"
      },
      {
        "path": ".gitlab-ci.yml",
        "scope": "any-depth"
      },
      {
        "path": "Jenkinsfile",
        "scope": "any-depth"
      },
      {
        "path": "azure-pipelines.yml",
        "scope": "any-depth"
      },
      {
        "path": ".circleci/config.yml",
        "scope": "root"
      },
      {
        "path": ".buildkite/**/*.yml",
        "scope": "glob"
      }
    ]
  },
  {
    "binding": "line",
    "check": "CI-02",
    "named_by_text": "each shell script a step runs is looked up with Inventory.has and read, one level deep",
    "note": "Each step command (inline or each line of a block), split at shell operators outside quotes, is mapped to a verb by runner or known tool and compared with the verbs resolved on the runner manifests. echo and printf text and heredoc bodies are not commands. A step that runs a repository shell script is read one script deep. No workflow, or no CI verb mapped, is UNKNOWN.",
    "source": "engine",
    "threshold": "no CI verb without a local definition",
    "what": {
      "kind": "key",
      "text": [
        "run",
        "script",
        "command",
        "commands",
        "bash"
      ]
    },
    "where": [
