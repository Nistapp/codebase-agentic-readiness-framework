      }
    ]
  },
  {
    "binding": "line",
    "check": "CI-05",
    "note": "Local evidence is any line of a file of kind manifest, build, config, script or other that names the provider's linter (check-jsonschema by its schema or hook names), never a workflow, a lockfile or a dependabot or renovate config. Then each workflow line is read for the same names.",
    "source": "engine",
    "threshold": "every provider's workflows linted locally",
    "what": {
      "kind": "word-list",
      "text": [
        "actionlint",
        "zizmor",
        "check-jsonschema",
        "glab ci lint",
        "circleci config validate"
      ]
    },
    "where": [
