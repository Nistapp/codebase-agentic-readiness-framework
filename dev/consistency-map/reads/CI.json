      {
        "path": "azure-pipelines.yml",
        "scope": "any-depth"
      },
      {
        "path": ".circleci/config.yml",
        "scope": "root"
      },
      {
        "path": ".buildkite/**/*.yml",
        "scope": "glob"
      },
      {
        "monotone": true,
        "path": "package.json",
        "scope": "root"
      },
