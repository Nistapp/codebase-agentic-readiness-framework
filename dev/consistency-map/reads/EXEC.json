  {
    "binding": "window",
    "check": "EXEC-05",
    "note": "The scan classifies a file as generated by a case-insensitive substring of its path (scan._GENERATED_HINTS), a folder named dist (scan._GENERATED_DIRS) or by suffix. A tracked text file under a folder named build (scan.SIGNED_GENERATED_DIRS) counts too when an ignore rule (the root ignore files and every nested .gitignore) also matches it; another file there keeps its own kind. Only tracked files are read. The marker must stand in the first 20 lines, case-insensitive.",
    "source": "engine",
    "threshold": "every tracked generated file carries a marker",
    "what": {
