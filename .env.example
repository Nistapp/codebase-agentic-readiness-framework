# Environment variables the code in this repository reads. None is required; each one only overrides a default.
# Copy a line into your shell (or a git-ignored .env) and set a value only when you need the override.

# greenfield/bootstrap/bootstrap.py: the template folder to render. Default: greenfield/templates/ beside the
# script. The --templates flag wins over this variable.
AGENTIC_BOOTSTRAP_TEMPLATES=
